void configurar_io() {
	// Puerto D: Todo salida (8 LEDs)
	DDRD = 0xFF;
  a6:	8f ef       	ldi	r24, 0xFF	; 255
  a8:	8a b9       	out	0x0a, r24	; 10
	
	// Puerto B: PB0 como salida (Neopixel)
	DDRB |= (1 << PB0);
  aa:	84 b1       	in	r24, 0x04	; 4
  ac:	81 60       	ori	r24, 0x01	; 1
  ae:	84 b9       	out	0x04, r24	; 4

	// Puerto C: PC0 y PC1 como entradas (0)
	DDRC &= ~((1 << PC0) | (1 << PC1));
  b0:	87 b1       	in	r24, 0x07	; 7
  b2:	8c 7f       	andi	r24, 0xFC	; 252
  b4:	87 b9       	out	0x07, r24	; 7
	// Activar Pull-ups internos (Escribir 1 en el PORT siendo entrada)
	PORTC |= (1 << PC0) | (1 << PC1);
  b6:	88 b1       	in	r24, 0x08	; 8
  b8:	83 60       	ori	r24, 0x03	; 3
  ba:	88 b9       	out	0x08, r24	; 8
  bc:	08 95       	ret

